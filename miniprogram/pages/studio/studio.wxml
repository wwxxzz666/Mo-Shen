<view class="studio-page">
  <view class="studio-head">
    <text class="studio-kicker">{{mode === 'quick' ? '灵感工坊' : (mode === 'standard' ? '故事工坊' : '长篇工坊')}}</text>
    <text class="studio-title">{{storyTitle}}</text>
    <text class="studio-status">{{statusText}}</text>
  </view>

  <view class="stage-card" wx:if="{{phase === 'preview' || phase === 'previewing'}}">
    <text class="stage-label">第一步 · 确认语言感觉</text>
    <text class="stage-title">先读 200 字，再决定是否写下去</text>
    <text class="preview-text" wx:if="{{previewText}}">{{previewText}}</text>
    <button class="secondary-button" bindtap="generatePreview" loading="{{phase === 'previewing'}}">{{previewText ? '重新试写' : '生成 200 字试写'}}</button>
    <button class="primary-button" bindtap="confirmPreview" wx:if="{{previewText && !previewConfirmed}}">这个风格可以</button>
    <button class="primary-button" bindtap="startCreation" wx:if="{{previewConfirmed}}">开始正式创作</button>
  </view>

  <view class="stage-card" wx:if="{{phase === 'outline'}}">
    <text class="stage-label">第二步 · 确认故事走向</text>
    <text class="stage-title">大纲准备好了</text>
    <scroll-view class="outline-content" scroll-y>{{outline}}</scroll-view>
    <button class="primary-button" bindtap="approveOutline">确认大纲，开始写正文</button>
  </view>

  <view class="stage-card" wx:if="{{phase === 'running' || phase === 'paused' || phase === 'completed'}}">
    <view class="progress-row">
      <text>第 {{currentChapter || 0}} / {{chapters}} 章</text>
      <text>{{progress}}%</text>
    </view>
    <progress percent="{{progress}}" stroke-width="3" activeColor="#7B9C87" backgroundColor="#DED8CE" />
    <text class="chapter-text" wx:if="{{currentChapterDraft}}">{{currentChapterDraft}}</text>
    <text class="empty-copy" wx:else>策划和大纲完成后，正文会在这里逐章出现。</text>
    <button class="secondary-button" bindtap="togglePause" wx:if="{{phase !== 'completed'}}">{{taskStatus === 'paused' ? '继续创作' : '完成本步骤后暂停'}}</button>
    <button class="primary-button" bindtap="viewManuscript" wx:if="{{phase === 'completed'}}">查看完整成稿</button>
  </view>

  <view class="error-card" wx:if="{{phase === 'error'}}">
    <text>{{statusText}}</text>
    <button class="secondary-button" bindtap="pollTask" wx:if="{{taskId}}">重试连接</button>
  </view>

  <view class="collaboration">
    <view class="collaboration-toggle" bindtap="toggleCollaboration">
      <text>Agent 协作详情</text>
      <text>{{showCollaboration ? '收起' : '查看'}}</text>
    </view>
    <view wx:if="{{showCollaboration}}">
      <view class="agent-row" wx:for="{{agents}}" wx:key="name">
        <text>{{index + 1}} · {{item.name}}</text>
        <text>{{item.status}}</text>
      </view>
    </view>
  </view>
</view>
