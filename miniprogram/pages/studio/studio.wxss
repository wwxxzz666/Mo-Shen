page {
  background: linear-gradient(145deg, #8fa99a 0%, #e8ede6 52%, #f7f2e9 100%);
  color: #3c352e;
  font-family: "Songti SC", "STSong", serif;
}

.studio-page {
  min-height: 100vh;
  padding: 32rpx 28rpx calc(52rpx + env(safe-area-inset-bottom));
}

.studio-head,
.stage-card,
.collaboration,
.error-card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  background: rgba(247, 242, 233, .78);
  border-radius: 24rpx;
  box-shadow: 0 18rpx 48rpx rgba(60, 53, 46, .12);
}

.studio-head { display: flex; flex-direction: column; gap: 12rpx; }
.studio-kicker, .stage-label { color: #b53b2c; font-size: 24rpx; letter-spacing: 4rpx; }
.studio-title, .stage-title { font-size: 40rpx; font-weight: 600; line-height: 1.5; }
.studio-status, .empty-copy { color: #6c665d; font-size: 28rpx; line-height: 1.8; }
.stage-card { display: flex; flex-direction: column; gap: 24rpx; }

.preview-text,
.chapter-text,
.outline-content {
  box-sizing: border-box;
  width: 100%;
  padding: 28rpx;
  color: #3c352e;
  background: rgba(232, 237, 230, .72);
  border-radius: 18rpx;
  font-size: 30rpx;
  line-height: 2;
  white-space: pre-wrap;
}

.outline-content { height: 620rpx; }
.chapter-text { max-height: 760rpx; overflow: hidden; }
.progress-row, .collaboration-toggle, .agent-row { display: flex; justify-content: space-between; gap: 24rpx; }
.progress-row { color: #6c665d; font-size: 26rpx; }

.primary-button,
.secondary-button {
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  border-radius: 16rpx;
  font-family: inherit;
  font-size: 30rpx;
  line-height: 88rpx;
}

.primary-button { color: #f7f2e9; background: #3c352e; }
.secondary-button { color: #3c352e; background: rgba(123, 156, 135, .18); }
.primary-button::after, .secondary-button::after { border: 0; }
.collaboration-toggle { min-height: 80rpx; align-items: center; }
.agent-row { padding: 24rpx 0; color: #6c665d; border-top: 1rpx dashed rgba(60, 53, 46, .2); }
.error-card { color: #b53b2c; line-height: 1.8; }
